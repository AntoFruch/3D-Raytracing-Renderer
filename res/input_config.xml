<?xml version="1.0" encoding="UTF-8" ?>
<InputActions>
    <Action label="Move" type="Vector2D">
        <!-- ZQSD -->
        <binding>
            <up bind="Z"/>
            <down bind="S"/>
            <left bind="Q"/>
            <right bind="D"/>
        </binding>
    </Action>
    <Action label="Jump" type="Button">
        <binding bind="Space"/>
    </Action>
    <Action label="Crouch" type="Button">
        <binding bind="LShift"/>
    </Action>
</InputActions>